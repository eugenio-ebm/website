---
import Layout from '../../layouts/Layout.astro';

import articles from "../../blog/articles.json"
---
<Layout>
    <div class="flex flex-col w-full gap-5">   
        <h1 class="text-xl text-center">Articles</h1>
        {articles.map((a) => (
            <div class="flex flex-col hover:bg-slate-100 duration-300 ease-out">
                <a href={a.link}>
                    <h1 class="font-semibold">{a.title}</h1>
                    <h2 class="italic">{a.subtitle}</h2>
                </a>
            </div>
        ))}
    </div>
</Layout>